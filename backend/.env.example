# Copy to backend/.env and fill the values (get them from spoOOokii privately
# — NEVER commit the real .env).

# Neon Postgres connection string (postgresql://user:pass@host/db)
DATABASE_URL=

# JWT signing key — any long random hex (python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth client id (Sign in with Google)
GOOGLE_CLIENT_ID=

# Comma-separated allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Gemini API key (aistudio.google.com/apikey) — chat fallback, embeddings, voice
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Live voice
LIVE_TTS_VOICE=Charon
