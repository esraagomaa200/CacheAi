# Copy to .env at the repo root and fill the values (get them from spoOOokii
# privately — NEVER commit the real .env). Used by the NAJDA RAG engine (app/).

# Groq API key (console.groq.com) — main chat models + NAJDA generation
GROQ_API_KEY=

# Qdrant Cloud cluster (cloud.qdrant.io) — the medical vector index
QDRANT_URL=
QDRANT_API_KEY=

# Gemini (same key as backend/.env is fine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_NORMALIZER_ENABLED=false
